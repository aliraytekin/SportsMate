<turbo-frame id="modal">
  <div class="modal fade show"
       tabindex="-1"
       style="display: block;"
       data-controller="modal"
       data-action="turbo:frame-load->modal#show">

    <div class="modal-dialog modal-right" style="max-width: 600px; height: auto;">
      <div class="modal-content" style="height: 600px; overflow-y: auto;">
        <div class="modal-header">
          <h5 class="card1-heading d-flex align-items-center">
            <% sport = event.sport %>
              <% if sport&.icon.present? %>
                <%= image_tag "#{sport.icon}" , class:"icon me-2", style: "width: 40px; height: 40px;" %>
             <% end %>
            <strong><%= event.title %></strong>
          </h5>
          <button type="button" class="btn-close btn-sm" data-action="modal#close" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <%= render 'form', event: event %>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
</turbo-frame>
