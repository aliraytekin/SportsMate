<div class="banner">
  <video autoplay muted loop playsinline class="banner-video">
    <source src="/videos/banner.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
  <div class="banner-content">
    <h1 data-controller="typed" class="mb-3">
      <span data-typed-target="output"></span></h1>
    <%= link_to "Discover events", events_path, class: "shining-button" %>
  </div>
</div>

<div class="orbit">
  <ul class="orbit-wrap">
    <div class="orbit-center">
      <li class="card fade-in" data-controller="fade-in" data-fade-in-target="card">
        <h1 class="text-blue">Meet teammates</h1>
        <p>Sportsmates makes it easy to connect
            with people who share your passion
            for sports. Whether you’re new in
            town or missing players for your weekly
            match, our website helps you find
            and join a team instantly. With user
            profiles and skill levels, you can
            quickly discover teammates who match your
            interests. No more struggling
            to meet people — just join an event
            or create one, and start building
            your team within minutes.</p>
          <% if user_signed_in? %>
            <%= link_to "Create an event", new_event_path, class: "shining-button" %>
          <% else %>
            <%= link_to "Sign up", new_user_registration_path, class: "shining-button" %>
          <% end %>
      </li>
    </div>
      <li>
        <ul class="ring-0" data-controller="fade-in">
          <li><img src="images/football.png" class="orbit-icon" alt="football-icon" data-fade-in-target="icon"></li>
          <li><img src="images/baseball.png" class="orbit-icon" alt="baseball-icon" data-fade-in-target="icon"></li>
          <li><img src="images/boxing.png" class="orbit-icon" alt="boxing-icon" data-fade-in-target="icon"></li>
          <li><img src="images/climbing.png" class="orbit-icon" alt="climbing-icon" data-fade-in-target="icon"></li>
        </ul>
      </li>

      <li>
        <ul class="ring-1" data-controller="fade-in">
          <li><img src="images/cycling.png" class="orbit-icon" alt="cycling-icon" data-fade-in-target="icon"></li>
          <li><img src="images/golf.png" class="orbit-icon" alt="golf-icon" data-fade-in-target="icon"></li>
          <li><img src="images/judo.png" class="orbit-icon" alt="judo-icon" data-fade-in-target="icon"></li>
        </ul>
      </li>
      <li>
        <ul class="ring-2" data-controller="fade-in">
          <li><img src="images/rugby.png" class="orbit-icon" alt="rugby-icon" data-fade-in-target="icon"></li>
          <li><img src="images/running.png" class="orbit-icon" alt="running-icon" data-fade-in-target="icon"></li>
          <li><img src="images/surfing.png" class="orbit-icon" alt="surfing-icon" data-fade-in-target="icon"></li>
          <li><img src="images/swimming.png" class="orbit-icon" alt="swimming-icon" data-fade-in-target="icon"></li>
          <li><img src="images/table-tennis.png" class="orbit-icon" alt="table-tennis-icon" data-fade-in-target="icon"></li>
          <li><img src="images/tennis.png" class="orbit-icon" alt="tennis-icon" data-fade-in-target="icon"></li>
        </ul>
      </li>
      <li>
        <ul class="ring-3">
          <li><img src="images/volleyball.png" class="orbit-icon" alt="volleyball-icon"></li>
          <li><img src="images/yoga.png" class="orbit-icon" alt="yoga-icon"></li>
        </ul>
      </li>
    </div>
  </ul>
</div>


<div id="features" class="container py-5">
  <div class="row text-center">
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm border-0 fade-in" data-controller="fade-in" data-fade-in-target="card">
        <div class="card-body">
          <img src="https://cdn-icons-png.flaticon.com/512/684/684908.png" class="mb-3" width="48" alt="Map">
          <h5 class="card-title fw-semibold">Find Nearby Events</h5>
          <p class="card-text text-muted">Use the map to explore local sports activities around you.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm border-0 fade-in" data-controller="fade-in" data-fade-in-target="card">
        <div class="card-body">
          <img src="https://cdn-icons-png.flaticon.com/512/1077/1077012.png" class="mb-3" width="48" alt="Group">
          <h5 class="card-title fw-semibold">Follow and share events</h5>
          <p class="card-text text-muted">Train with people who share your goals and energy.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm border-0 fade-in" data-controller="fade-in" data-fade-in-target="card">
        <div class="card-body">
          <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" class="mb-3" width="48" alt="Calendar">
          <h5 class="card-title fw-semibold">Plan & Track Activities</h5>
          <p class="card-text text-muted">Register for events and stay consistent with your schedule.</p>
        </div>
      </div>
    </div>
  </div>
</div>


<div class="cta-section py-5 bg-light">
  <div class="container text-center">
    <h2 class="fw-bold mb-4 fs-2">Ready to join the community?</h2>
    <%= link_to "Sign Up Now", new_user_registration_path, class: "simple-primary-button btn-lg px-5 py-3 rounded-pill shadow-sm" %>
  </div>
</div>
