<div id="message_<%= message.id %>" class="message <%= message.sender_id == current_user_id ? 'sent' : 'received' %>">
  <small class="message-info">
    <span>
      <%= link_to message.sender do %>
        <%= message.sender.avatar.key.present? ? cl_image_tag(message.sender.avatar.key, class: "message-avatar") :
        image_tag("default_avatar.png", class: "message-avatar") %>
      <% end %>
      <strong><%= message.sender_id == current_user_id ? 'You' : message.sender.first_name.capitalize %></strong>
    </span>

    <span class="message-time">
      <i><%= message.created_at.strftime("%a %b %e at %l:%M %p") %></i>
    </span>
  </small>



  <p class="message-content"><%= message.content %></p>
</div>
