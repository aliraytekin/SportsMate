<div class="white-background">
  <div class="container d-flex justify-content-center align-items-center">
    <div class="banner-event">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "rounded-circle-event me-4", style: "width: 60px; height: 60px;" %>
          <% else %>
            <%= image_tag "default_avatar.png", class: "rounded-circle-event me-4", style: "width: 60px; height: 60px;" %>
          <% end %>
          <h3 class="card-banner mb-0 align-self-center">
            Hi <%= current_user.first_name %>, Welcome To Sportsmate Events Dashboard. The Home For All Sport Lovers.<br>
            Here You Can View And Manage Your Event Participations In Real-Time.
          </h3>
        </div>
        <%= link_to raw('<i class="fas fa-comment-dots me-2"></i>Chat Us'), "#", class: "btn btn-outline-light" %>
      </div>
    </div>
  </div>


  <%# ---- 1. Participating in Other Users' Events ---- %>

  <% if @other_participations.any? %>
  <h3 class="card-heading-event mt-5 mb-5 ms-6" >&raquo; EVENTS PARTICIPATION &raquo;</h3>
    <div class="row">
      <% @other_participations.each do |participation| %>
        <%= render partial: "participation_card", locals: { participation: participation } %>
      <% end %>
    </div>
  <% end %>

  <%# ---- 2. Events You Organize ---- %>

  <% if @owned_events.any? %>
  <h3 class="card-heading-event mt-5 mb-5 ms-6">&raquo; ORGANIZED EVENTS &raquo;</h3>
    <div class="row">
      <% @owned_events.each do |event| %>
        <%= render partial: "event_card", locals: { event: event } %>
      <% end %>
    </div>
  <% end %>

  <%# ---- 3. Cancelled Participations ---- %>

  <% if @cancelled_participations.any? %>
  <h3 class="card-heading-event mt-5 mb-5 ms-6">&raquo; CANCELLED EVENTS </h3>
    <div class="row">
      <% @cancelled_participations.each do |participation| %>
        <%= render partial: "participation_card", locals: { participation: participation } %>
      <% end %>
    </div>
  <% end %>
</div>
