<% event = participation.event %>
<div class="card1 col-md-3">
  <% if event.photos.attached? %>
    <%= cl_image_tag event.photos.first.key, transformation: [{ width: 390, height: 150, crop: "fill" }], class: "card-image-event", style: "object-fit: contain;" %>
  <% else %>
    <div class="card-image-event bg-secondary d-flex align-items-center justify-content-center" style="height: 150px;width: 390px;">
      <span class="text-white-50">No Image Available</span>
    </div>
  <% end %>

  <div class="card1-content">
    <h5 class="card1-heading d-flex align-items-center">
      <% sport = participation.event.sport %>
        <% if sport&.icon.present? %>
          <%= image_tag "#{sport.icon}" , class:"icon me-2", style: "width: 40px; height: 40px;" %>
        <% end %>
    <strong><%= event.title %></strong>
    </h5>

    <p class="card-text-event"><i class="fa-solid fa-note-sticky me-1"></i><%= truncate(event.description, length: 100, separator: ' ', omission: '...') %></p>
    <div class="list-event">
      <ul class="list-unstyled mb-3">
        <li><i class="fa-regular fa-calendar me-1"></i> <%= event.start_time.strftime("%B %d, %Y") %> <i class="fa-solid fa-clock ms-5 me-1"></i> <%= event.start_time.strftime("%H:%M") %></li>
        <% if event.venue.present? || event.city.present? %>
          <li><i class="fa-solid fa-location-dot me-2"></i><%= [event.venue, event.city].compact.join(', ') %></li>
        <% end %>
      </ul>
    </div>
    <div class="mb-2 d-flex align-items-center gap-2">
      <% if participation.status == "attending" %>
        <span class="mb-0"><strong>Status:</strong></span>
        <span class="badg"><i class="fa-solid fa-circle-check me-2 mt-1" style="color: green;"></i>Attending</span>
      <% elsif participation.status == "cancelled" %>
        <span class="mb-0"><strong>Status:</strong></span>
        <span class="badg"><i class="fa-solid fa-circle-left me-2 mt-1" style="color: black;"></i>Left the event</span>
      <% end %>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
      <%= link_to "More Details", event_path(event), class: "shining-button1" %>
      <% if participation.status == "attending" && event.user != current_user %>
        <%= button_to "Leave",
              cancel_participation_participation_path(participation),
              method: :patch,
              data: { turbo: false, confirm: "Are you sure you want to leave this event?" },
              class: "shining-button-red" %>
      <% end %>
    </div>
  </div>
</div>
