<%= turbo_stream_from "chat_#{[current_user.id, @user.id].sort.join("_")}" %>

<div class="container chat">
  <%= link_to user_path do %>
    <i class="fa-solid fa-arrow-left"></i>
  <% end %>
  <h2 class="text-center">Chat with <%= @user.first_name %></h2>
  <div id="messages" class="messages">
    <%= render @messages, current_user_id: current_user.id %>
  </div>

  <%= form_with model: @new_message, url: messages_path,
    data: { controller: "reset-form",
    action: "turbo:submit-end->reset-form#reset" },
    class: "d-flex align-items-center gap-3 mt-2" do |f| %>
    <%= f.hidden_field :recipient_id, value: @user.id %>
    <%= f.text_area :content, placeholder: "Write a message...", class: "message-input form-control flex-grow-1 px-3 py-2" %>
    <%= f.submit "Send", class: "shining-button" %>
  <% end %>
</div>
