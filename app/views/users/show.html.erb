<div class="container mt-4">
  <h1 class="section-title">My Profile</h1>
  <h2 class="user-name"><%= "#{@user.first_name} #{@user.last_name}" %></h2>
  <p class="user-bio"><%= @user.bio %></p>

  <h3 class="section-title mt-5">My Interests</h3>

  <div class="row">
    <div class="col-md-7">
      <div class="row">
        <% @user.user_sport_interests.each do |interest| %>
          <% sport = interest.sport %>
          <div class="col-md-6 mb-4">
            <div class="interest-card-background">
              <div class="interest-bg" data-controller="interest-video" data-action="mouseenter->interest-video#play mouseleave->interest-video#pause">
                <video
                  data-interest-video-target="video"
                  class="card-background-video"
                  muted
                  loop
                  playsinline
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
                  <source src="<%= asset_path("sports/#{sport.name.downcase}.mp4") %>" type="video/mp4">
                  <img src="<%= asset_path("#{sport.icon}") %>" alt="<%= sport.name %>" class="fallback-icon" />
                </video>
                <div class="interest-overlay"></div>
              </div>
              <div class="interest-content text-white">
                <h5><%= sport.name %></h5>
                <p><strong>Skill:</strong> <%= interest.skill_level %></p>

                <% if current_user == @user %>
                  <div class="mt-2">
                    <%= simple_form_for interest, html: { class: "text-white" } do |f| %>
                      <div class="mb-2">
                        <%= f.input :skill_level, collection: UserSportInterest::SKILL_LEVELS, label: false, input_html: { class: "form-control" } %>
                      </div>
                      <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="shining-button">Save</button>
                        <%= link_to "Delete", user_sport_interest_path(interest), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: " shining-button alert-color-background" %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-md-5">
      <% if current_user == @user %>
        <div class="fixed-sidebar-form sport-card p-4 mb-4 shadow-sm">
          <h4 class="text-center mb-3">Add New Sport</h4>
          <%= render "user_sport_interests/form", user_sport_interest: @user_sport_interest %>
        </div>
      <% else %>
        <div class="sport-card p-4 mb-4 shadow-sm text-center">
          <% if current_user.following.include?(@user) %>
            <%= button_to "Unfollow", follow_path(current_user.active_follows.find_by(followed_id: @user.id)), method: :delete, class: "shining-button mb-2" %>
          <% else %>
            <%= button_to "Follow", user_follows_path(@user), method: :post, class: "shining-button mb-2" %>
          <% end %>
          <%= link_to "Chat with #{@user.first_name}", chat_user_path(@user), class: "shining-button" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
